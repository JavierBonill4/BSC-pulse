        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(bsc_rpc_latency_seconds_bucket{network=\"$network\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{endpoint}}"
        }
