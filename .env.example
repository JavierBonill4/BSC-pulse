# Copy to .env (git-ignored) and fill in. Never commit the real file.
# Nothing here is needed for `make probe`; these are read by later steps.

# Telegram alerts (create a bot with @BotFather, then find the chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana admin password for the local and deployed stack
GRAFANA_ADMIN_PASSWORD=
