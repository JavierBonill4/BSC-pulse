# Copy to .env (git-ignored) and fill in. Never commit the real file.
# Docker Compose reads .env automatically. For `make notify` / `make telegram-test`,
# export them in your shell first:  set -a; source .env; set +a

# Telegram alerts. Leave empty for a dry run (messages are printed to the log).
# 1. In Telegram, message @BotFather, send /newbot, copy the token.
# 2. Send any message to your new bot.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana admin password (user: admin). Required: `make up` refuses to start without it.
GRAFANA_ADMIN_PASSWORD=
